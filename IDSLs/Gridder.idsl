/*
 * Gridder Interface
 * =================
 *
 * ICE interface for the Gridder component, providing 2D occupancy grid
 * services and path planning capabilities.
 *
 * Main Services:
 *   - Path planning between two points with configurable safety
 *   - Line-of-sight checking for direct paths
 *   - Map serialization for network transmission
 *   - Grid dimension management
 *
 * Data Structures:
 *   - TPoint: 2D point with optional radius (for obstacle/robot representation)
 *   - TPath/TPaths: Sequences of points representing paths
 *   - TCell/Map: Compact map representation for efficient transmission
 *   - Result: Path computation result with status and multiple path options
 *
 * Usage Example (C++):
 *   auto result = gridder_proxy->getPaths(source, target, 3, true, false, 0.5f);
 *   if (!result.paths.empty()) {
 *       auto path = result.paths[0];  // Best path
 *   }
 *
 * Author: RoboLab - University of Extremadura
 * Date: 2024-2025
 */

module RoboCompGridder
{
	// 2D point with optional bounding radius
	struct TPoint
	{
		float x;        // mm - x coordinate
        float y;        // mm - y coordinate
        float radius;   // mm - radius of the object's bounding box (optional)
	};
	
	sequence <TPoint> TPointVector;
	sequence <TPoint> TPath;         // Single path: sequence of waypoints
	sequence <TPath> TPaths;         // Multiple alternative paths

	// Grid dimensions in world coordinates
	struct TDimensions
	{
        float left;     // mm - left boundary
        float top;      // mm - top boundary
	    float width;    // mm - grid width
        float height;   // mm - grid height
	};

	// Path computation result
	struct Result
	{
		TPaths paths;       // Computed paths (may be empty if no path found)
		long timestamp;     // Computation timestamp (ms since epoch)
		string errorMsg;    // Error/status message
		bool valid;         // True if computation succeeded
	};

    // Compact cell representation for map transmission
    // Only cells with cost > 0 are transmitted (sparse representation)
    struct TCell
    {
        int x;          // mm - cell x position (center)
        int y;          // mm - cell y position (center)
        byte cost;      // 0=free, 255=obstacle, 100-200=inflation layers
    };

    sequence <TCell> TCellVector;

    // Serialized map for network transmission
    // Contains only non-free cells for efficiency
    struct Map
    {
        int tileSize;           // mm - size of each cell (typically 100mm)
        TCellVector cells;      // Cells with cost > 0
    };

    // Robot pose with covariance
    sequence<float> Covariance;
    struct Pose
    {
        float x;          // mm - x position
        float y;          // mm - y position
        float theta;      // radians - orientation
        Covariance cov;  // Flattened 3x3 covariance matrix
    };

    // =========================================================================
    // Navigation Control Structures
    // =========================================================================

    /**
     * Navigation state enumeration
     * Represents the current state of the navigation controller
     */
    enum NavigationState {
        IDLE,           // No target set, robot stopped
        NAVIGATING,     // Moving towards target
        PAUSED,         // Stopped but target still active (can resume)
        REACHED,        // Target reached, robot stopped
        BLOCKED,        // Path blocked, attempting to replan
        ERROR           // Critical error (localization lost, etc.)
    };

    /**
     * Navigation options for customizing navigation behavior
     */
    struct NavigationOptions {
        float maxSpeed;         // mm/s - maximum allowed speed (0 = use default)
        float safetyFactor;     // 0.0-1.0 - prefer safer paths (0=fastest, 1=safest)
        bool useEsdf;           // Use ESDF for smooth obstacle costs
        bool allowReplan;       // Allow automatic replanning if path blocked
    };

    /**
     * Complete navigation status
     * Provides full information about current navigation state
     */
    struct NavigationStatus {
        NavigationState state;          // Current navigation state
        TPoint currentTarget;           // Current target (0,0 if IDLE)
        TPoint currentPosition;         // Robot's estimated position
        float currentOrientation;       // Robot's estimated orientation (radians)
        float distanceToTarget;         // mm - remaining distance to target
        float estimatedTime;            // seconds - estimated time to arrival
        float currentSpeed;             // mm/s - current robot speed
        int pathWaypointsRemaining;     // Number of waypoints remaining in path
        string statusMessage;           // Human-readable status message
    };

    /**
     * Gridder Interface
     *
     * Provides path planning, occupancy grid services, and navigation control.
     */
    interface Gridder
    {
        /**
         * Compute paths from source to target.
         * @param source Starting point
         * @param target Destination point
         * @param maxPaths Maximum number of alternative paths to compute
         * @param tryClosestFreePoint If true, find closest free point if target is blocked
         * @param targetIsHuman If true, apply human-aware path planning
         * @param safetyFactor 0.0=shortest path, 1.0=safest path (prefer center of free space)
         * @return Result with computed paths and status
         */
        Result getPaths(TPoint source, TPoint target, int maxPaths,
                        bool tryClosestFreePoint, bool targetIsHuman, float safetyFactor);

        /**
         * Find the closest free cell to a given point.
         * @param source Point to search from
         * @return Closest free point, or (0,0) if none found
         */
        TPoint getClosestFreePoint(TPoint source);

        /**
         * Set grid dimensions (clears existing grid).
         * @param dimensions New grid boundaries
         * @return True if successful
         */
        bool setGridDimensions(TDimensions dimensions);

        /**
         * Check if there is a clear line of sight between two points.
         * @param source Starting point
         * @param target Destination point
         * @param robotRadius Robot radius for collision checking
         * @return True if line of sight is free
         */
        bool LineOfSightToTarget(TPoint source, TPoint target, float robotRadius);

        /**
         * Check if a path is blocked by obstacles.
         * @param path Path to check
         * @return True if path is blocked
         */
        bool IsPathBlocked(TPath path);

        /**
         * Update grid with obstacle/free points and compute path.
         * @param source Starting point
         * @param target Destination point
         * @param freePoints Points known to be free
         * @param obstaclePoints Points known to be obstacles
         * @return Result with computed path
         */
        Result setLocationAndGetPath(TPoint source, TPoint target,
                                     TPointVector freePoints, TPointVector obstaclePoints);

        /**
         * Get current grid dimensions.
         * @return Grid boundaries
         */
        TDimensions getDimensions();

        /**
         * Get serialized map (only cells with cost > 0).
         * Efficient for network transmission.
         * @return Compact map representation
         */
        Map getMap();

         /**
         * Get robot pose and pose covariance
         */
        Pose getPose();

        // =====================================================================
        // Navigation Control Methods
        // =====================================================================

        /**
         * Set navigation target and start navigating.
         * Computes path and begins navigation immediately.
         * @param target Destination point
         * @return True if target is valid and reachable
         */
        bool setTarget(TPoint target);

        /**
         * Set navigation target with custom options.
         * @param target Destination point
         * @param options Navigation configuration (speed, safety, etc.)
         * @return True if target is valid and reachable
         */
        bool setTargetWithOptions(TPoint target, NavigationOptions options);

        /**
         * Start or resume navigation to current target.
         * @return True if navigation started (false if no target set)
         */
        bool startNavigation();

        /**
         * Stop robot but keep current target.
         * Robot can be resumed with startNavigation() or resumeNavigation().
         * Sets state to PAUSED.
         */
        void stopNavigation();

        /**
         * Resume navigation after stop/pause.
         * @return True if navigation resumed (false if no target or already navigating)
         */
        bool resumeNavigation();

        /**
         * Cancel navigation completely.
         * Stops the robot AND clears the current target.
         * Sets state to IDLE.
         */
        void cancelNavigation();

        /**
         * Force path replanning to current target.
         * Useful when environment has changed significantly.
         * @return True if new path found
         */
        bool replanPath();

        /**
         * Get current navigation state.
         * @return Current state (IDLE, NAVIGATING, PAUSED, REACHED, BLOCKED, ERROR)
         */
        NavigationState getNavigationState();

        /**
         * Get complete navigation status.
         * Includes state, target, position, distances, timing, etc.
         * @return Full navigation status structure
         */
        NavigationStatus getNavigationStatus();

        /**
         * Get current navigation target.
         * @return Current target point (0,0,0 if no target set)
         */
        TPoint getTarget();

        /**
         * Get remaining distance to target.
         * @return Distance in mm (0 if no target or reached)
         */
        float getDistanceToTarget();

        /**
         * Get estimated time to reach target.
         * @return Estimated time in seconds (-1 if cannot estimate)
         */
        float getEstimatedTimeToTarget();

        /**
         * Check if robot has reached the current target.
         * @return True if target reached (state == REACHED)
         */
        bool hasReachedTarget();

    };
};

