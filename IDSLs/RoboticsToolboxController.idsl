module RoboCompRoboticsToolboxController
{ 
  sequence<float> JointAngles;
  sequence<float> TargetPosition;
  sequence<float> JointVelocities;
  
  struct JointStates
  {
  	JointVelocities jointVelocities;
  	bool arrived;
  };
  
  interface RoboticsToolboxController
  {
	JointStates calculateVelocitiesPedro(JointAngles angles, TargetPosition targetPosition);
	JointStates calculateVelocitiesPablo(JointAngles angles, TargetPosition targetPosition);
	void setStatePedro(JointAngles angles);
	void setStatePablo(JointAngles angles);
  };
};
