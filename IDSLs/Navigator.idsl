/*
 * Navigator Interface
 * =================
 *
 * ICE interface for the ainf_slamo component, providing localization, path planning and control services.
 *
 * Main Services:
 *   - Path planning between two points with configurable safety
 *   - Line-of-sight checking for direct paths
 *   - Space layout serialization for efficient communication
 *   - Target definition and management for navigation tasks
 *   - Navigation control for local path following and obstacle avoidance

 * Data Structures:
 *   - TPoint: 2D point  (for obstacle/robot representation)
 *   - TPath: Sequences of points representing paths
 *   - Result: Path computation result with status and multiple path options
 *
 * Usage Example (C++):
 *   auto result = ainf_slamo_proxy->getPath(source, target, safety);
 *   ainf_slamo_proxy->setTarget(1.0, 0.0); // Move to (1.0, 0.0)
 *   ainf_slamo_proxy->gotoObject("planta 1 hall");
 *   ainf_slamo_proxy->stop(0.0, 0.0, 0.0);
 *   ainf_slamo_proxy->resume(0.0, 0.0, 0.0);
 *   ainf_slamo_proxy->getLayout(); // Get space layout for visualization
 *
 * Author: RoboLab - University of Extremadura
 * Date: 2024-2025
 */

module RoboCompNavigator
{
    // 2D point with optional bounding radius
	struct TPoint
	{
		float x;        // m - x coordinate
        float y;        // m - y coordinate
	};
  	sequence<TPoint> TPath;

    // Path computation result
	struct Result
	{
		TPath path;         // Computed paths (may be empty if no path found)
		long timestamp;     // Computation timestamp (ms since epoch)
		string errorMsg;    // Error/status message
		bool valid;         // True if computation succeeded
	};

	// Robot pose with covariance
    sequence<float> TCov;
    struct Pose
    {
        float x;          // m - x position
        float y;          // m - y position
        float theta;      // radians - orientation
        TCov cov;         // xx xy xt yy yt tt
    };

    /**
     * Navigation state enumeration
     * Represents the current state of the navigation controller
     */
    enum NavigationState {
        IDLE,           // No target set, robot stopped
        NAVIGATING,     // Moving towards target
        PAUSED,         // Stopped but target still active (can resume)
        REACHED,        // Target reached, robot stopped
        BLOCKED,        // Path blocked, attempting to replan
        ERROR           // Critical error (localization lost, etc.)
    };

    /**
     * Complete navigation status
     * Provides full information about current navigation state
     */
    struct NavigationStatus {
        NavigationState state;          // Current navigation state
        TPoint currentTarget;           // Current target (0,0 if IDLE)
        TPoint currentPosition;         // Robot's estimated position
        float currentOrientation;       // Robot's estimated orientation (radians)
        float distanceToTarget;         // m - remaining distance to target
        float estimatedTime;            // seconds - estimated time to arrival
        float currentSpeed;             // m/s - current robot speed
        int pathWaypointsRemaining;     // Number of waypoints remaining in path
        string statusMessage;           // Human-readable status message
    };

    sequence<TPoint> TLayout;
    struct TObject
    {
        string name;
        TLayout layout;
    };
    sequence<TObject> TObjects;
    struct LayoutData
    {
        TLayout layout;
        TObjects objects;
    };

	interface Navigator
	{
	    Result getPath(TPoint source, TPoint target, float safety);
	    LayoutData getLayout();
        void stop();
	    TPoint gotoPoint(TPoint target);
	    TPoint gotoObject(string object);
        void resume();
  	};

};
