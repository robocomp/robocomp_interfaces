module RoboCompVRControllerPub
{
  struct Pose
  {
    float x;
    float y;
    float z;
    float qrx;
    float qry;
    float qrz;
    float qrw;
  };

  struct Controller
  {
    Pose pose;
    float trigger;
    float grab;
    float x;
    float y;
    float thumbstickCapTouch;
    bool aButton;
    float aButtonCapTouch;
    bool bButton;
    float bButtonCapTouch;
  };

  struct Haptic
  {
    float intensity;
    float frequency;
  };

  interface VRControllerPub
  {
    void sendData(Pose head, Controller left, Controller right);
    void sendPoses(Pose head, Pose left, Pose right);
    void sendControllers(Controller left, Controller right);
    void sendHaptics(Haptic left, Haptic right);
  };
};
