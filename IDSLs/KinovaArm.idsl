module RoboCompKinovaArm
{
    	enum ArmJoints { base, shoulderOne, shoulderTwo, elbowOne, elbowTwo, wristOne, wristTwo };

	struct TPose
	{
		float x;
		float y;
		float z;
		float rx;
		float ry;
		float rz;
		float qta;
		float qtb;
		float qtc;
		float qtd;
		string parent;
	};
	
	struct TAxis{
		float x;
		float y;
		float z;
	};
	
	struct TToolInfo
	{
		TAxis pose;
		TAxis poseTheta;
		TAxis twistLinear;
		TAxis twistAngular;
		TAxis externalWrenchForce;
		TAxis externalWrenchTorque;
	};

	struct TGripper
	{
	    float opening;
	    float lforce;        // left  finger linear-motor force feedback (grip/clamp force, N) — grip-confirm signal
	    float rforce;        // right finger linear-motor force feedback (grip/clamp force, N)
	    // Raw fingertip force-3d CONTACT vectors (N), per pad, in the sensor (finger) frame. These REPLACE
	    // the old scalar ltipforce/rtipforce magnitudes (= the norm of these): the components carry the
	    // LATERAL/shear direction the compliant close needs to centre the bottle between the pads.
	    float lfx; float lfy; float lfz;   // left  pad force-3d {Fx,Fy,Fz}
	    float rfx; float rfy; float rfz;   // right pad force-3d {Fx,Fy,Fz}
	    bool  ltipcontact;   // distal-tip bumper, left finger  (binary contact, no force-relaxation)
	    bool  rtipcontact;   // distal-tip bumper, right finger
	    float distance;      // back-of-gripper point lidar → object distance (future; populated by bridge)
	};
	
	struct TJoint
	{
		int id;
		float angle;
		float velocity;
		float torque;
		float current;
		float voltage;
		float motorTemperature;
		float coreTemperature;
	};
	
	sequence <TJoint> TJointSeq;
	
	struct TJoints
	{
		TJointSeq joints;
		long timestamp;
	};

	sequence <float> Speeds;
	
	struct TJointSpeeds
	{
		Speeds jointSpeeds;
	};
	
	sequence <float> Angles;
	
	struct TJointAngles
	{
		Angles jointAngles;
	};

	interface KinovaArm
	{
		bool closeGripper ();
		bool setGripperPos (float pos);
		TPose getCenterOfTool (ArmJoints referencedTo);
		TToolInfo getToolInfo();
		TGripper getGripperState ();
		TJoints getJointsState ();
		void openGripper ();
		void setCenterOfTool (TPose pose, ArmJoints referencedTo);
		void moveJointsWithSpeed(TJointSpeeds speeds);
		void moveJointsWithAngle(TJointAngles angles);
	};
};


