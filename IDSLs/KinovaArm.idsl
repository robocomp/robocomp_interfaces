module RoboCompKinovaArm
{
    	enum ArmJoints { base, shoulderOne, shoulderTwo, elbowOne, elbowTwo, wristOne, wristTwo };

	struct TPose
	{
		float x;
		float y;
		float z;
		float rx;
		float ry;
		float rz;
		float qta;
		float qtb;
		float qtc;
		float qtd;
		string parent;
	};
	
	struct TAxis{
		float x;
		float y;
		float z;
	};
	
	struct TToolInfo
	{
		TAxis pose;
		TAxis poseTheta;
		TAxis twistLinear;
		TAxis twistAngular;
		TAxis externalWrenchForce;
		TAxis externalWrenchTorque;
	};

	struct TGripper
	{
	    float opening;
	    float lforce;
	    float ltipforce;
	    float rforce;
	    float rtipforce;
	    float distance;
	};
	
	struct TJoint
	{
		int id;
		float angle;
		float velocity;
		float torque;
		float current;
		float voltage;
		float motorTemperature;
		float coreTemperature;
	};
	
	sequence <TJoint> TJointSeq;
	
	struct TJoints
	{
		TJointSeq joints;
		long timestamp;
	};

	sequence <float> Speeds;
	
	struct TJointSpeeds
	{
		Speeds jointSpeeds;
	};
	
	sequence <float> Angles;
	
	struct TJointAngles
	{
		Angles jointAngles;
	};

	interface KinovaArm
	{
		bool closeGripper ();
		bool setGripperPos (float pos);
		TPose getCenterOfTool (ArmJoints referencedTo);
		TToolInfo getToolInfo();
		TGripper getGripperState ();
		TJoints getJointsState ();
		void openGripper ();
		void setCenterOfTool (TPose pose, ArmJoints referencedTo);
		void moveJointsWithSpeed(TJointSpeeds speeds);
		void moveJointsWithAngle(TJointAngles angles);
	};
};


