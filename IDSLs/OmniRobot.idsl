import "GenericBase.idsl";

module RoboCompOmniRobot
{
  struct TMechParams
  {
    float temp;
    string device;
    string handler;
    float maxVelAdv;
    float maxVelRot;
  };

  // No operation declares a user exception. slice2cpp then omits the
  // _checkTwowayOnly() guard on the void, no-out-parameter operations, so they can
  // be invoked oneway (proxy->ice_oneway()): the caller returns as soon as the
  // request is written to the socket instead of waiting for a reply.
  // getBaseState/getBasePose have out parameters and stay twoway regardless.
  interface OmniRobot
  {
    void getBaseState(out RoboCompGenericBase::TBaseState state);
    void getBasePose(out int x, out int z, out float alpha);
    void setSpeedBase(float advx, float advz, float rot);
    void stopBase();
    void resetOdometer();
    void setOdometer(RoboCompGenericBase::TBaseState state);
    void setOdometerPose(int x, int z, float alpha);
    void correctOdometer(int x, int z, float alpha);
  };
};


