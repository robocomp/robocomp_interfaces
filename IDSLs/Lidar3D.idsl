module RoboCompLidar3D
{
  sequence<int> TCategories;

  struct TPoint
  {
    float x;
    float y;
    float z;
    int intensity;
    float phi;
    float theta;
    float r;
    float distance2d;
    /*Lidar values proyected to image in XY*/
    int pixelX;
    int pixelY;
  };
  sequence<TPoint> TPoints;
  
  sequence<float> TFloatArray;
  sequence<int> TIntArray;
  sequence<short> TShortArray;
  sequence<byte> TByteArray;

  // Provenance and clock, carried by every struct below that has a `timestamp`.
  //   timestamp    - wall-clock epoch ms, ALWAYS. Unchanged meaning; keep using it for latency,
  //                  staleness and watchdogs, in simulation too.
  //   simTimestamp - the instant the sample was ACQUIRED, on the simulator's own clock (ms since
  //                  world load). 0 when `simulated` is false. A simulator's velocities and rates
  //                  are per SIMULATION second, so anything integrating them must integrate over
  //                  this clock, not over `timestamp`, or it over-counts by the sim/wall ratio.
  //   simulated    - true when a simulator produced this sample. Lets a consumer pick its time base
  //                  from the data instead of from a config flag it could get wrong, and keeps
  //                  working when real and simulated sources share a topic.
  struct TDataImage
  {
      long timestamp;
      long simTimestamp;
      bool simulated;
      TFloatArray XArray;
      TFloatArray YArray;
      TFloatArray ZArray;
      TIntArray XPixel;
      TIntArray YPixel;    
  };

  struct TData
  {
    TPoints points;
    float period;
    long timestamp;
    long simTimestamp;
    bool simulated;
  };
  
  struct TDataCategory
  {

    TFloatArray XArray;
    TFloatArray YArray;
    TFloatArray ZArray;
    TCategories CategoriesArray;
    float period;
    long timestamp;
    long simTimestamp;
    bool simulated;
  };

  struct TColorCloudData 
  {
    TShortArray X;
    TShortArray Y;
    TShortArray Z;
    TByteArray R;
    TByteArray G;
    TByteArray B;
    long timestamp;
    long simTimestamp;
    bool simulated;
    long numberPoints;
    
    //compressed data, include R, G and B as compress data
    bool compressed;
    TByteArray cX;
    TByteArray cY;
    TByteArray cZ;
    
  };

  interface Lidar3D
  {
	/** @brief Get lidar data */
	TData getLidarData(string name, float start, float len, int decimationDegreeFactor);
	TData getLidarDataWithThreshold2d(string name, float distance, int decimationDegreeFactor);
	TData getLidarDataProyectedInImage(string name);
	TDataCategory getLidarDataByCategory(TCategories categories, long timestamp);
	TDataImage getLidarDataArrayProyectedInImage(string name);
  TColorCloudData getColorCloudData();

  };
};
